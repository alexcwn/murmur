<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Deliberately NOT sandboxed. The App Sandbox denies both the global
	  CGEventTap and the Accessibility APIs this app is built on, so a sandboxed
	  build cannot detect the hotkey or insert text. That also rules out the Mac
	  App Store; Developer ID + notarization is the distribution path.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
